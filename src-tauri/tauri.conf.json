{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hub des Savoirs",
  "version": "1.1.1",
  "identifier": "com.hubdessavoirs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hub des Savoirs",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://docs.google.com https://*.googleusercontent.com https://github.com https://objects.githubusercontent.com ipc: http://ipc.localhost; frame-src https://docs.google.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0Q0JBRTc0OUZBMjYzOEYKUldTUFk2S2ZkSzdMdEhsTEhoM1lEbTN3L1VQUHhQVjlWTVR0T3ZscTdiVXFJLzdTOWdGTFBDSlEK",
      "endpoints": [
        "https://github.com/gabrielluthun/hub-des-savoirs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
